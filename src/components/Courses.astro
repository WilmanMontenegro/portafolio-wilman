---
interface Props {
    preview?: boolean;
}

const { preview = false } = Astro.props;
const base = import.meta.env.BASE_URL;

interface CourseItem {
    period: string;
    title: string;
    role: string;
    summary: string;
}

const courses: CourseItem[] = [
    {
        period: '2026',
        title: 'Marketing con IA para Emprendedores',
        role: 'Docente · bloque técnico',
        summary:
            'Curso que dicté junto a Ana María Murillo. Bloque técnico: fundamentos de IA generativa, LLMs, prompts y herramientas aplicadas a marketing.',
    },
];
---

<section
    class="section-wrapper"
    id="courses"
    aria-labelledby="courses-title"
>
    <p class="font-mono text-[0.82rem] text-cyan/65 mb-2 tracking-[0.05em]" aria-hidden="true">
        &lt;section&gt; teaching
    </p>
    <h2
        class="grad-text font-mono text-[clamp(1.7rem,3vw,2.4rem)] font-bold mb-6"
        id="courses-title"
    >
        Cursos dictados
    </h2>

    <div class="grid gap-5 md:grid-cols-2">
        {
            courses.map((item) => (
                <article class="grid gap-2 rounded-xl border border-purple/20 bg-[rgba(27,8,64,0.6)] p-[1.4rem]">
                    <p class="font-mono text-[0.78rem] text-cyan/65 tracking-[0.04em]">
                        {item.period}
                    </p>
                    <h3 class="font-mono text-[1.05rem] text-text">
                        {item.title}
                    </h3>
                    <p class="font-mono text-[0.86rem] text-purple">
                        {item.role}
                    </p>
                    <p class="text-[0.92rem] leading-[1.7] text-muted">
                        {item.summary}
                    </p>
                </article>
            ))
        }
    </div>
    {
        preview && (
            <div class="mt-6 text-right">
                <a
                    href={`${base}experiencia#courses`}
                    class="font-mono text-[0.82rem] text-cyan transition-opacity hover:opacity-70"
                    aria-label="Ver cursos dictados"
                >
                    Ver cursos dictados →
                </a>
            </div>
        )
    }
    <p
        class="font-mono text-[0.82rem] text-cyan/65 mt-2 mb-0 text-right tracking-[0.05em]"
        aria-hidden="true"
    >
        &lt;/section&gt;
    </p>
</section>
