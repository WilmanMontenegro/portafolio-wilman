---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: 'website' | 'article';
}

const {
  title = 'Wilman Montenegro | Ingeniero de Desarrollo de Software',
  description = 'Ingeniero de Desarrollo de Software en Bogotá, Colombia. Desarrollo web y móvil con React, Next.js, Node.js, NestJS, Java y Spring Boot.',
  image = `${import.meta.env.BASE_URL}wilman-montenegro.webp`,
  imageAlt,
  imageWidth,
  imageHeight,
  ogType = 'website',
} = Astro.props;

const site = Astro.site ?? Astro.url;
const shareImage = new URL(image, site).href;
const shareImageAlt =
  imageAlt ??
  'Wilman Montenegro Calderón, Ingeniero de Desarrollo de Software en Bogotá, Colombia';
const shareImageType = shareImage.endsWith('.png')
  ? 'image/png'
  : shareImage.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';

const canonical = new URL(Astro.url.pathname, site).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Wilman Montenegro Calderón",
  "alternateName": "Wilman Montenegro",
  "url": "https://wilman.dev",
  "jobTitle": "Ingeniero de Desarrollo de Software",
  "worksFor": { "@type": "Organization", "name": "Freelance" },
  "email": "wilmanmc15@gmail.com",
  "address": { "@type": "PostalAddress", "addressLocality": "Bogotá", "addressCountry": "CO" },
  "knowsAbout": ["Desarrollo de software", "Desarrollo web", "React", "Next.js", "Vue.js", "Angular", "Node.js", "NestJS", "Java", "Spring Boot", "PHP", "Python", "TypeScript", "C#", ".NET", "Django", "Laravel", "Flutter", "Docker", "AWS Lightsail", "PostgreSQL", "MySQL", "MongoDB", "Supabase", "Firebase", "WordPress"],
  "sameAs": [
    "https://github.com/WilmanMontenegro",
    "https://www.linkedin.com/in/wilman-montenegro/",
    "https://www.instagram.com/wilman.dev/",
    "https://x.com/WilmanDev",
    "https://www.facebook.com/WilmanM.dev/"
  ],
  "image": "https://wilman.dev/wilman-montenegro.webp",
  "description": description,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Wilman Montenegro" />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#100425" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:secure_url" content={shareImage} />
    <meta property="og:image:type" content={shareImageType} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="wilman.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <meta name="twitter:site" content="@WilmanDev" />
    <meta name="twitter:creator" content="@WilmanDev" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preload" as="image" href="/wilman-montenegro.webp" fetchpriority="high" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Source+Sans+3:wght@400;500;600;700&display=swap&subset=latin-ext" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@2.16.0/devicon.min.css" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5KZC2BYLGH"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5KZC2BYLGH');
    </script>
  </head>
  <body>
    <a class="absolute -top-12 left-4 z-[2000] py-3 px-4 rounded bg-purple text-white font-display text-sm focus-visible:top-4" href="#content">Saltar al contenido</a>
    <Navbar />
    <main class="pt-6" id="content">
      <slot />
    </main>
    <footer class="mt-16 border-t border-purple/10 py-6 text-center font-display text-[0.78rem] text-muted/50">
      <p>© {new Date().getFullYear()} Wilman Montenegro · wilman.dev</p>
    </footer>
  </body>
</html>
